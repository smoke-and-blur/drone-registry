# Скопіюйте у .env та підставте власні значення.
# .env у git не потрапляє (див. .gitignore).

# Рядок підключення до MongoDB Atlas.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=DS-1
MONGO_DB=drone_registry

# Пароль для входу (спільний для всіх). Обов'язковий — без нього сервер не стартує.
APP_PASSWORD=change-me

# Необов'язково: секрет для підпису сесій. Якщо не задано — походить від пароля,
# тому зміна APP_PASSWORD автоматично завершує всі сесії.
SESSION_SECRET=

# PORT задає хостинг (Render). Локально — 8080 за замовчуванням.
